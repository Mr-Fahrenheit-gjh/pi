# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# local quick-start state (no credentials)
/.pi-web-start.json*
/.pi-web-setup.lock
/.pi/background-tasks/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.api-key
**/auth.json
**/mcp-auth.json

# misc
.DS_Store
*.pem
/.agents/
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs
