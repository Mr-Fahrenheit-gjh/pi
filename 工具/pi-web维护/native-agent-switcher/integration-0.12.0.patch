+}
+
+function SafeText({ text }: { text: string }) {
+  return <pre className="my-2 max-h-96 overflow-auto whitespace-pre-wrap break-words rounded bg-[var(--bg)] p-3 text-sm [overflow-wrap:anywhere]">{text}</pre>;
+}
