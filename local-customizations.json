{
  "schemaVersion": 1,
  "upstreamRef": "v0.12.1",
  "supportedSdkVersions": ["1.2.0"],
  "dependencyOverrides": {
    "ghostty-web": "0.4.0",
    "@xterm/addon-fit": null,
    "@xterm/xterm": null
  },
  "requiredSourceMarkers": {
    "app/globals.css": ["claude-white", "font-weight: 800"],
    "app/workspace.css": [".composer-card", ".workspace-session-title", ".message-usage"],
    "components/AppShell.tsx": ["workspace.sessionActions", "workspace-settings-entry", "workspace-title-menu"],
    "components/ChatInput.tsx": ["composer-card", "data-composer-send", "ContextUsageRing", "useRunningSendMode"],
    "components/ContextUsageRing.tsx": ["data-context-ring", "strokeDasharray"],
    "components/SettingsPanel.tsx": ["running-send-mode", "settings.runningSendMode"],
    "hooks/useRunningSendMode.ts": ["pi-running-send-mode", "RUNNING_SEND_MODE_DEFAULT"],
    "components/ActionMenuButton.tsx": ["SidebarMenu", "aria-haspopup=\"menu\""],
    "components/RevealFileButton.tsx": ["files.revealInFinder", "reveal: true"],
    "components/MessageView.tsx": ["message-usage", "chat.messageUsage"],
    "components/TerminalPanel.tsx": ["is-toolbarless", "data-terminal-status", "terminal-ghostty"],
    "components/FileViewer.tsx": ["srcDoc=", "sandbox=\"allow-scripts\"", "effectiveDisplayMode", "RevealFileButton"],
    "components/ChatWindow.tsx": ["data-process-details", "onContextUsageClick"],
    "hooks/useAgentSession.ts": ["bindChatScrollIntent", "userScrollingAwayRef"],
    "hooks/useResizablePanel.ts": ["data-panel-drag-shield", "event.key !== \"Escape\""],
    "components/ImagePreview.tsx": ["zoomImageAt", "image-preview-viewport"],
    "lib/chat-scroll-intent.ts": ["bindChatScrollIntent"],
    "lib/image-viewport.ts": ["zoomImageAt", "clampImageTransform"],
    "lib/package-subagent-bridge.ts": ["export"],
    "app/api/agent/[id]/subagents/route.ts": ["export"]
  }
}
